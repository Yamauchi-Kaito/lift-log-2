{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "supabase:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start",
    "supabase:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "supabase:status": "SUPABASE_TELEMETRY_DISABLED=1 supabase status -o env",
    "format": "oxfmt",
    "preflight:e2e": "node scripts/preflight-e2e.mjs",
    "test:e2e": "npm run preflight:e2e && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.2.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
