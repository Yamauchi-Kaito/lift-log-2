# 必ず本番とは別のSupabase projectを使う。値はGitに追加しない。
VITE_SUPABASE_URL=https://YOUR_E2E_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_E2E_PUBLISHABLE_KEY

# Playwrightが起動するVite serverの代わりに既存環境を使う場合のみ設定する。
# E2E_BASE_URL=http://127.0.0.1:4173

# Auth setup: passwordを持つ専用test user。Magic Linkメール操作は不要。
E2E_OWNER_EMAIL=owner-e2e@example.invalid
E2E_OWNER_PASSWORD=change-me
E2E_ADMIN_EMAIL=admin-e2e@example.invalid
E2E_ADMIN_PASSWORD=change-me
E2E_MEMBER_EMAIL=member-e2e@example.invalid
E2E_MEMBER_PASSWORD=change-me

# 既存storageStateを使う場合は上のemail/passwordの代わりに指定できる。
# E2E_OWNER_STORAGE_STATE=playwright/.auth/e2e-owner.json
# E2E_ADMIN_STORAGE_STATE=playwright/.auth/e2e-admin.json
# E2E_MEMBER_STORAGE_STATE=playwright/.auth/e2e-member.json

# 3ユーザーだけが参加するテスト専用team。実ユーザー/実teamは禁止。
E2E_TEST_TEAM_NAME=E2E Team
# E2E_TEST_TEAM_ID=00000000-0000-0000-0000-000000000000
E2E_TEST_EXERCISE_NAME=E2E Exercise

# falseのままではDB/Storageを変更するspecをskipする。
E2E_ENABLE_MUTATION_TESTS=false
